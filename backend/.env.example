# TraceNest Backend Configuration

# Application Metadata
PROJECT_NAME="TraceNest API"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server Networking
HOST="0.0.0.0"
PORT=8000

# CORS Configuration (JSON array or comma-separated list of allowed frontend origins)
# In development:
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# In production (example):
# BACKEND_CORS_ORIGINS=["https://tracenest.vercel.app"]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tracenest
# Local async URL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tracenest
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tracenest_test
# Cloud managed database example (Neon / Supabase / Render):
# DATABASE_URL=postgresql+asyncpg://user:strong_password@ep-xyz.neon.tech/tracenest?ssl=require

# Rate Limiting & Abuse Prevention
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TELEMETRY_PER_MINUTE=120
RATE_LIMIT_INVESTIGATE_PER_MINUTE=15
RATE_LIMIT_PROJECT_CREATE_PER_MINUTE=10
PROJECT_REGISTRATION_ENABLED=true

# AI Investigation Assistant Settings (Phase 5)
# Supported providers: openai_compatible, mock
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Set your API key here (backend-only, NEVER exposed to client)
AI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_EVENTS_PER_INVESTIGATION=5
AI_MAX_STACK_TRACE_CHARS=2000
